{
  "name": "@vsadtajo/adasa-ui",
  "version": "0.5.0",
  "description": "Librería corporativa ADASA de componentes Vue 3 + TypeScript: mapas (agnósticos del motor: Leaflet, MapLibre...) y, por dominios, gráficas, tablas, detalle, layout y formularios.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VSADTajo/adasa-map-widgets.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js",
      "require": "./dist/map.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "require": "./dist/layout.cjs"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js",
      "require": "./dist/forms.cjs"
    },
    "./detail": {
      "types": "./dist/detail.d.ts",
      "import": "./dist/detail.js",
      "require": "./dist/detail.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "typesVersions": {
    "*": {
      "map": [
        "./dist/map.d.ts"
      ],
      "charts": [
        "./dist/charts.d.ts"
      ],
      "layout": [
        "./dist/layout.d.ts"
      ],
      "forms": [
        "./dist/forms.d.ts"
      ],
      "detail": [
        "./dist/detail.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.playground.ts",
    "build": "npm run type-check && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --config vite.config.ts",
    "check:entries": "node scripts/check-entries.mjs",
    "build:playground": "npm run type-check && vite build --config vite.config.playground.ts",
    "preview:playground": "vite preview --config vite.config.playground.ts --outDir dist-playground",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:charts": "vite --config vite.config.playground.ts --open /perf.html?engine=echarts",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@geomatico/maplibre-cog-protocol": "^0.9.1",
    "@tmcw/togeojson": "^7.1.0",
    "apexcharts": "^8.0.0",
    "chart.js": "^4.4.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.0.0",
    "chartjs-plugin-zoom": "^2.0.0",
    "echarts": "^6.0.0",
    "fflate": "^0.8.0",
    "georaster": "^1.6.0",
    "georaster-layer-for-leaflet": "^4.1.2",
    "leaflet": "^1.9.0",
    "leaflet.vectorgrid": "^1.3.0",
    "maplibre-gl": "^6.0.0",
    "topojson-client": "^3.1.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@geomatico/maplibre-cog-protocol": {
      "optional": true
    },
    "@tmcw/togeojson": {
      "optional": true
    },
    "apexcharts": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "chartjs-adapter-date-fns": {
      "optional": true
    },
    "chartjs-plugin-annotation": {
      "optional": true
    },
    "chartjs-plugin-zoom": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "fflate": {
      "optional": true
    },
    "georaster": {
      "optional": true
    },
    "georaster-layer-for-leaflet": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "leaflet.vectorgrid": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "topojson-client": {
      "optional": true
    }
  },
  "dependencies": {
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.9.0",
    "@geomatico/maplibre-cog-protocol": "^0.9.1",
    "@iconify-json/tabler": "^1.2.42",
    "@iconify/vue": "^5.0.4",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@tmcw/togeojson": "^7.1.2",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.vectorgrid": "^1.3.10",
    "@types/node": "^20.14.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.5.1",
    "apexcharts": "^8.3.1",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "echarts": "^6.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "fflate": "^0.8.3",
    "georaster": "^1.6.0",
    "georaster-layer-for-leaflet": "^4.1.2",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "leaflet.vectorgrid": "^1.3.0",
    "lucide-vue-next": "^1.0.0",
    "maplibre-gl": "^6.2.0",
    "prettier": "^3.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.0.3",
    "vitest": "^3.2.7",
    "vue": "^3.4.38",
    "vue-tsc": "^2.0.29"
  }
}
